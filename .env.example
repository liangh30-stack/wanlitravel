# 所有变量仅供服务端（server/）读取，绝不注入前端打包产物。

# ── TourDiez (T10) Sirio Integration Web Services ──
# 仅服务端使用，绝不通过 vite define 注入前端！
# 三个模块各有独立入口（下面是 T10 提供的测试环境地址；生产地址认证通过后索取）：
T10_BOOKING_URL="http://testapi.tourdiez.com/2.9/booking/ApiServlet.Srv"
T10_MAPPING_URL="http://testapi.tourdiez.com/3.1/mapping/ApiServlet.Srv"
T10_RESERVATIONS_URL="http://testapi.tourdiez.com/3.1/reservations/ApiServlet.Srv"
T10_USER="USUARIO000"
T10_PASSWORD="PWD0000"
T10_LOG_DIR="./logs/t10"

# 目的地下拉框：优先使用 Mapping 同步表（server/scripts/sync-mapping.ts），
# 下面这个手写列表只是同步表为空时的兜底。
# 测试环境只有 ES00634（Torremolinos）挂了价格，4 家酒店：Mlg0846,Mlg1295,Mlg1141,Mlg0902
T10_DESTINATIONS="ES00634:Torremolinos · Costa del Sol (test)"

# ── 前端 → 服务端 API 鉴权 ──
# 生产环境必填：前端（或反向代理）调用 /api 时携带 X-Api-Key 头。
# 生成方式：openssl rand -hex 32
API_SHARED_KEY=""

# ── 询盘通知 webhook（可选）──
# 新表单提交时 POST 通知到此地址；飞书/企微/Slack 的 incoming webhook 均可。
INQUIRY_WEBHOOK_URL=""
