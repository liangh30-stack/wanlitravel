# 所有变量仅供服务端（server/）读取，绝不注入前端打包产物。

# ── TourDiez (T10) Sirio Integration Web Services ──
# 仅服务端使用，绝不通过 vite define 注入前端！
T10_BASE_URL="https://SERVIDOR_T10/endpoint"
T10_USER="USUARIO000"
T10_PASSWORD="PWD0000"
T10_LOG_DIR="./logs/t10"

# ── 前端 → 服务端 API 鉴权 ──
# 生产环境必填：前端（或反向代理）调用 /api 时携带 X-Api-Key 头。
# 生成方式：openssl rand -hex 32
API_SHARED_KEY=""
